{"cells":[{"cell_type":"code","source":["def merge_sort(arr):\n","\n","    if len(arr) <= 1:\n","        return arr\n","\n","    mid = len(arr) // 2\n","    left = merge_sort(arr[:mid])\n","    right = merge_sort(arr[mid:])\n","\n","\n","    return merge(left, right)\n","\n","\n","def merge(left, right):\n","    result = []\n","    i = 0\n","    j = 0\n","\n","    while i < len(left) and j < len(right):\n","        if left[i] <= right[j]:\n","            result.append(left[i])\n","            i += 1\n","        else:\n","            result.append(right[j])\n","            j += 1\n","\n","    result.extend(left[i:])\n","    result.extend(right[j:])\n","\n","    return result\n","\n","\n","arr = [38, 27, 43, 3, 9, 82, 10]\n","\n","print(\"Original array:\", arr)\n","\n","sorted_arr = merge_sort(arr)\n","\n","print(\"Sorted array:\", sorted_arr)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Lupc-IvZ5U1W","executionInfo":{"status":"ok","timestamp":1790395659987,"user_tz":-330,"elapsed":41,"user":{"displayName":"","userId":""}},"outputId":"4d8645c4-956d-4233-837f-ec194904291a"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Original array: [38, 27, 43, 3, 9, 82, 10]\n","Sorted array: [3, 9, 10, 27, 38, 43, 82]\n"]}]}],"metadata":{"colab":{"name":"Welcome to Colab","toc_visible":true,"provenance":[{"file_id":"/v2/external/notebooks/intro.ipynb","timestamp":1790395703512}]},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}